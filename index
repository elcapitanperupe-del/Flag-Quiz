/* =========================================
   COUNTRY LOOKUP
========================================= */

const countryByCode = new Map(
    countries.map(([name, code]) => [
        code,
        { name, code }
    ])
);

const allCodes = countries.map(country => country[1]);

/* =========================================
   DIFFICULTY POOLS
========================================= */

const EASY_CODES = [
    "US","CN","IN","BR","RU","JP","DE","GB","FR","IT",
    "CA","MX","AU","ES","KR","AR","TH","NL","SA","ZA",
    "EG","NG","SE","CH","PL"
];

const NORMAL_EXTRA = [
    "PH","VN","CO","PE","PK","NO","NZ","IR","GR","PT",
    "IE","HU","IL","SG","BE","DK","MY","CL","EC","VE",
    "CR","BD","IQ","MA","DZ"
];

const DIFFICULT_EXTRA = [
    "KZ","UZ","TJ","KG","LK","NP","KH","LA","MM","JO",
    "KW","OM","QA","AE","BH","IS","FI","HR","RS","BA",
    "ME","MK","RO","BG","SK","SI","LV","LT","EE","MV",
    "TN","PA","PY","BO","HN","GT","SV","NI","CU","DO",
    "JM","HT","TT","AD","AG","BS","BB","BZ","BJ","BT",
    "BW","BN","BF","BI","CV"
];

const uniqueCodes = codes => [...new Set(codes)];

const DIFFICULTY_POOLS = {

    easy: uniqueCodes(EASY_CODES),

    normal: uniqueCodes([
        ...EASY_CODES,
        ...NORMAL_EXTRA
    ]),

    difficult: uniqueCodes([
        ...EASY_CODES,
        ...NORMAL_EXTRA,
        ...DIFFICULT_EXTRA
    ]),

    veryDifficult: allCodes,

    hardcore: allCodes

};

const DIFFICULTY_LIMITS = {

    easy: 25,

    normal: 50,

    difficult: 100,

    veryDifficult: allCodes.length,

    hardcore: allCodes.length

};

/* =========================================
   GAME VARIABLES
========================================= */

let activeCountries = [];
let remainingCountries = [];

let score = 0;
let answered = 0;
let maxQuestions = 0;

let currentCountry = null;
let answerLocked = false;
let currentMode = "";

let gameSession = 0;

const homeButton = document.getElementById("homeButton");
const flagImage = document.getElementById("flag");

const flagFallback = document.getElementById("flagFallback");
const flagEmoji = document.getElementById("flagEmoji");
const flagCode = document.getElementById("flagCode");

/* =========================================
   UTILITIES
========================================= */

function shuffle(array) {

    const result = [...array];

    for (let i = result.length - 1; i > 0; i--) {

        const j = Math.floor(Math.random() * (i + 1));

        [result[i], result[j]] = [result[j], result[i]];

    }

    return result;

}

function disableAnswerButtons() {

    document.querySelectorAll("#options button")
        .forEach(button => {
            button.disabled = true;
        });

}

function enableDifficultyButtons() {

    document.querySelectorAll("#difficulty-selection button")
        .forEach(button => {
            button.disabled = false;
        });

    homeButton.disabled = true;

}

/* =========================================
   FLAG LOADING AND FALLBACK
========================================= */

function getFlagEmoji(code) {

    return code
        .toUpperCase()
        .split("")
        .map(letter =>
            String.fromCodePoint(127397 + letter.charCodeAt(0))
        )
        .join("");

}

function loadFlag(country) {

    flagImage.style.display = "block";
    flagFallback.hidden = true;

    flagEmoji.textContent = getFlagEmoji(country.code);
    flagCode.textContent = country.code;

    flagImage.onerror = function () {

        flagImage.style.display = "none";
        flagFallback.hidden = false;

    };

    flagImage.onload = function () {

        flagImage.style.display = "block";
        flagFallback.hidden = true;

    };

    flagImage.src =
        `https://flagcdn.com/w320/${country.code.toLowerCase()}.png`;

}

/* =========================================
   MENU
========================================= */

function goToMenu() {

    gameSession++;

    document.getElementById("quiz").style.display = "none";

    document.getElementById("difficulty-selection").style.display = "flex";

    document.getElementById("message").textContent = "";

    document.getElementById("options").innerHTML = "";

    enableDifficultyButtons();

}

/* =========================================
   START GAME
========================================= */

function startGame(level) {

    gameSession++;

    document.getElementById("difficulty-selection").style.display = "none";

    document.getElementById("quiz").style.display = "flex";

    homeButton.disabled = false;

    currentMode = level;

    activeCountries = DIFFICULTY_POOLS[level]
        .map(code => countryByCode.get(code))
        .filter(Boolean);

    maxQuestions = Math.min(
        DIFFICULTY_LIMITS[level],
        activeCountries.length
    );

    remainingCountries = shuffle(activeCountries);

    score = 0;
    answered = 0;

    currentCountry = null;

    answerLocked = false;

    document.getElementById("message").textContent = "";

    showNextFlag();

}

/* =========================================
   NEXT FLAG
========================================= */

function showNextFlag() {

    answerLocked = false;

    document.getElementById("message").textContent = "";

    if (answered >= maxQuestions) {

        finishGame();

        return;

    }

    currentCountry = remainingCountries.pop();

    loadFlag(currentCountry);

    const wrongAnswers = shuffle(

        activeCountries.filter(country =>

            country !== currentCountry

        )

    ).slice(0, 3);

    const options = shuffle([

        currentCountry.name,

        ...wrongAnswers.map(country => country.name)

    ]);

    const optionsContainer = document.getElementById("options");

    optionsContainer.innerHTML = "";

    options.forEach(option => {

        const button = document.createElement("button");

        button.textContent = option;

        button.onclick = () => checkAnswer(option);

        optionsContainer.appendChild(button);

    });

    updateScore();

}

/* =========================================
   CHECK ANSWER
========================================= */

function checkAnswer(answer) {

    if (answerLocked) return;

    answerLocked = true;

    disableAnswerButtons();

    const message = document.getElementById("message");

    answered++;

    if (answer === currentCountry.name) {

        score++;

        message.textContent = "✅ Correct!";

        message.style.color = "green";

    } else {

        message.textContent = `❌ Incorrect. The answer was ${currentCountry.name}`;

        message.style.color = "red";

        if (currentMode === "hardcore") {

            message.textContent =
                `💀 GAME OVER! The correct answer was ${currentCountry.name}. 💀`;

            updateScore();

            const session = gameSession;

            setTimeout(() => {

                if (session === gameSession) {

                    goToMenu();

                }

            }, 3000);

            return;

        }

    }

    updateScore();

    const session = gameSession;

    setTimeout(() => {

        if (session === gameSession) {

            showNextFlag();

        }

    }, 900);

}

/* =========================================
   FINISH GAME
========================================= */

function finishGame() {

    disableAnswerButtons();

    const message = document.getElementById("message");

    message.textContent =
        `🏁 You guessed ${score} out of ${maxQuestions} flags! 🏁`;

    message.style.color = "#174c25";

    updateScore();

    const session = gameSession;

    setTimeout(() => {

        if (session === gameSession) {

            goToMenu();

        }

    }, 3000);

}

/* =========================================
   SCORE
========================================= */

function updateScore() {

    document.getElementById("score").textContent =
        `Score: ${score} / ${maxQuestions}`;

}

</script>

