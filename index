
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FLAG QUIZ</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    padding: 20px;
    font-family: Arial, sans-serif;

    /* Original-style background, generated locally with CSS */
    background:
        radial-gradient(circle at 15% 20%, rgba(84,180,170,.24) 0 2px, transparent 3px),
        radial-gradient(ellipse at 85% 20%, rgba(123,190,160,.18), transparent 35%),
        radial-gradient(ellipse at 20% 85%, rgba(55,130,170,.25), transparent 40%),
        linear-gradient(135deg, #102b3f, #17444a 55%, #13253c);

    display: flex;
    align-items: center;
    justify-content: center;
}

/* Decorative background pattern */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .13;
    background:
        repeating-linear-gradient(
            0deg,
            transparent 0px,
            transparent 49px,
            rgba(255,255,255,.12) 50px
        ),
        repeating-linear-gradient(
            90deg,
            transparent 0px,
            transparent 49px,
            rgba(255,255,255,.12) 50px
        );
}

.quiz,
#difficulty-selection {
    position: relative;
    z-index: 1;
    background: rgba(255,255,255,.95);
    width: 380px;
    max-width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 18px;
    border-radius: 15px;
    box-shadow: 0 0 20px rgba(0,0,0,.5);
    text-align: center;
    display: flex;
    flex-direction: column;
}

h2 {
    font-size: 21px;
    margin: 8px 0 14px;
}

.flag-box {
    width: 100%;
    height: 160px;
    margin: 10px 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.flag-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0,0,0,.3);
}

.flag-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #e9edf0;
    border-radius: 8px;
    font-size: 65px;
}

.flag-fallback small {
    font-size: 15px;
    color: #555;
    font-weight: bold;
}

[hidden] {
    display: none !important;
}

#options {
    flex-grow: 1;
}

button {
    width: 100%;
    padding: 10px;
    margin: 6px 0;
    font-size: 16px;
    font-weight: 500;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: transform .15s, filter .15s;
}

button:hover:enabled {
    transform: scale(1.03);
    filter: brightness(.94);
}

button:disabled {
    opacity: .65;
    cursor: not-allowed;
}

.easy {
    background: #28a745;
    color: white;
}

.normal {
    background: #ffc107;
    color: #222;
}

.difficult {
    background: #ff0000;
    color: white;
}

.very-difficult {
    background: #800080;
    color: white;
}

.hardcore {
    background: #000;
    color: red;
}

.score {
    font-size: 16px;
    font-weight: bold;
    margin-top: 8px;
}

#message {
    margin-top: 8px;
    font-weight: bold;
    min-height: 24px;
}

#homeButton {
    position: fixed;
    z-index: 10;
    top: 10px;
    left: 10px;
    width: auto;
    padding: 6px 10px;
    font-size: 20px;
    border-radius: 8px;
    background: white;
    border: 2px solid #ccc;
    box-shadow: 0 0 8px rgba(0,0,0,.3);
}

#homeButton:hover:enabled {
    box-shadow: 0 0 10px gold;
}

@media (max-width: 430px) {
    body {
        padding: 12px;
    }

    .quiz,
    #difficulty-selection {
        width: 100%;
        padding: 15px;
    }

    h2 {
        font-size: 19px;
    }

    .flag-box {
        height: 145px;
    }
}
</style>
</head>

<body>

<!-- Home button -->
<button id="homeButton" onclick="goToMenu()" disabled>🏠</button>

<!-- Difficulty selection -->
<div id="difficulty-selection">

    <h2>CHOOSE YOUR DIFFICULTY:</h2>

    <button class="easy" onclick="startGame('easy')">
        😄 EASY (25) 😄
    </button>

    <button class="normal" onclick="startGame('normal')">
        😐 NORMAL (50) 😐
    </button>

    <button class="difficult" onclick="startGame('difficult')">
        😡 DIFFICULT (100) 😡
    </button>

    <button class="very-difficult" onclick="startGame('veryDifficult')">
        👿 VERY DIFFICULT (ALL) 👿
    </button>

    <button class="hardcore" onclick="startGame('hardcore')">
        💀 HARDCORE (???) 💀
    </button>

</div>

<!-- Quiz -->
<div class="quiz" id="quiz" style="display:none;">

    <h2>WHICH COUNTRY DOES THIS FLAG BELONG TO?</h2>

    <div class="flag-box">

        <img id="flag" alt="Country flag">

        <div id="flagFallback" class="flag-fallback" hidden>
            <span id="flagEmoji"></span>
            <small id="flagCode"></small>
        </div>

    </div>

    <div id="options"></div>

    <div class="score" id="score"></div>

    <div id="message"></div>

    <div id="credits" style="margin-top:12px;font-size:12px;color:#555;min-height:14px;"></div>

</div>

<script>

